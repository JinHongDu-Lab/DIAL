# Copy this file to ".env" in this same directory and fill in only the keys
# you have. Never commit ".env" -- it is already listed in .gitignore.
# Ollama judges need none of these.

# https://platform.openai.com/api-keys -- used by openai-gpt-4.1-nano-batch-direct
OPENAI_API_KEY=

# https://console.anthropic.com/settings/keys -- used by anthropic-claude-haiku-4.5-batch-direct
# NOTE: the variable name below (missing the "h") matches configs/apis.json
# exactly -- do not "fix" the spelling, or the account reference will break.
ANTROPIC_API_KEY=

# https://aistudio.google.com/apikey -- used by google-gemini-3.1-flash-lite-batch-minimal
GEMINI_API_KEY=
